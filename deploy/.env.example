# Public DNS names that resolve to this host.
CONTROL_DOMAIN=control.example.com
DATA_DOMAIN=data.example.com

# Optional space-separated CIDRs allowed to reach the control plane.
# The default permits all IPv4 and IPv6 sources.
CONTROL_ALLOWED_CIDRS=0.0.0.0/0 ::/0

# Optional control console base path, such as /admin.
# Leave empty to serve the console at /auth and /console.
CONTROL_BASE_PATH=

# Used by Caddy for ACME account notifications.
ACME_EMAIL=ops@example.com

# Must match Slider's --proto value.
SLIDER_PROTOCOL=slider-v2

# Optional host port overrides.
HTTP_PORT=80
HTTPS_PORT=443
